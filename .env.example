# ── Supabase (Postgres + PostGIS) ────────────────────────────
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Redpanda (Kafka-compatible) ──────────────────────────────
KAFKA_BROKERS=localhost:19092
# For Redpanda Cloud, uncomment:
# KAFKA_SASL_USERNAME=your-user
# KAFKA_SASL_PASSWORD=your-password
# KAFKA_SSL=true

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── USGS Feed ────────────────────────────────────────────────
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_BACKFILL_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_month.geojson
POLL_INTERVAL_SEC=60

# ── App ──────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
DASHBOARD_URL=http://localhost:5173

# ── Web (Vite) ───────────────────────────────────────────────
# Point frontend at local API during dev. No spaces around =.
VITE_API_URL=http://localhost:3000

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ── Tavily (web search) ──────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key

# ── Agent ────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_MS=60000

# ── App ──────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
