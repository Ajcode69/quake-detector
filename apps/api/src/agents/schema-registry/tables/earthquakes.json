{
  "table": "earthquakes",
  "description": "USGS earthquake events ingested into the system",
  "columns": [
    { "name": "id", "type": "text", "description": "USGS event id" },
    { "name": "mag", "type": "float", "description": "Magnitude" },
    { "name": "mag_type", "type": "text", "description": "Magnitude type (ml, mw, etc.)" },
    { "name": "place", "type": "text", "description": "Human-readable location" },
    { "name": "event_time", "type": "timestamptz", "description": "When the quake occurred" },
    { "name": "updated_at", "type": "timestamptz", "description": "Last USGS revision" },
    { "name": "sig", "type": "int", "description": "Significance score 0-1000" },
    { "name": "alert", "type": "text", "description": "PAGER level: green/yellow/orange/red" },
    { "name": "tsunami", "type": "int", "description": "1 if tsunami flag set, else 0" },
    { "name": "depth", "type": "float", "description": "Depth in km" },
    { "name": "latitude", "type": "float", "description": "Latitude" },
    { "name": "longitude", "type": "float", "description": "Longitude" },
    { "name": "status", "type": "text", "description": "automatic or reviewed" },
    { "name": "url", "type": "text", "description": "USGS event page URL" }
  ],
  "allowedOperations": ["SELECT"],
  "exampleQueries": [
    "SELECT id, mag, place, event_time FROM earthquakes WHERE event_time > NOW() - INTERVAL '24 hours' ORDER BY mag DESC NULLS LAST LIMIT 10"
  ],
  "notes": "Prefer latitude/longitude over geog for agent queries"
}
