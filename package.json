{
  "name": "quake-detector",
  "version": "1.0.0",
  "description": "Earthquake monitoring, alerting and dashboard — streaming-aware monolith",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node apps/api/src/index.js",
    "ingest": "node apps/ingestion/src/index.js",
    "backfill": "node apps/ingestion/src/backfill.js",
    "migrate": "node scripts/migrate.js",
    "dev": "concurrently \"npm run api\" \"npm run ingest\"",
    "topics": "node scripts/setup-topics.js"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "node-cron": "^3.0.3",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
