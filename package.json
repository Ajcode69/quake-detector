{
  "name": "quake-detector",
  "version": "1.0.0",
  "description": "Earthquake monitoring, alerting and dashboard — streaming-aware monolith",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "node apps/api/src/index.js",
    "ingest": "node apps/ingestion/src/index.js",
    "web": "npm run dev --prefix apps/web",
    "backfill": "node apps/ingestion/src/backfill.js",
    "migrate": "npx prisma db push && node scripts/migrate.js",
    "generate": "npx prisma generate",
    "studio": "npx prisma studio",
    "dev": "concurrently \"npm run api\" \"npm run ingest\" \"npm run web\"",
    "topics": "node scripts/setup-topics.js"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^7.8.0"
  },
  "prisma": {
    "seed": "node scripts/seed.js"
  }
}
