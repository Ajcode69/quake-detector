// ── User alert rules ────────────────────────────────────────
// Custom per-user alert thresholds. Overrides global defaults.
model UserAlertRule {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId      Int?     @map("location_id")
  minMag          Float    @default(3.0) @map("min_mag")
  alertOnTsunami  Boolean  @default(true) @map("alert_on_tsunami")
  alertOnPager    String[] @default(["orange", "red"]) @map("alert_on_pager")
  quietHoursStart Int?     @map("quiet_hours_start") // 0-23 UTC
  quietHoursEnd   Int?     @map("quiet_hours_end")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  location UserLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@map("user_alert_rules")
}

